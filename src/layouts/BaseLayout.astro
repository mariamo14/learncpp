---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.tsx";
import ProgressBar from "../components/ProgressBar.tsx";
import ProgressTools from "../components/ProgressTools.tsx";
import { buildNav, allExerciseSlugs } from "../lib/nav";
import { withBase } from "../lib/site";

interface Props {
  title: string;
  currentLessonSlug?: string;
}

const { title, currentLessonSlug } = Astro.props;
const modules = await buildNav();
const exerciseSlugs = allExerciseSlugs(modules);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · learncpp</title>
    <meta
      name="description"
      content="An interactive, auto-graded C++ course you can run entirely in the browser."
    />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-[#0b1220] text-slate-200">
    <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] min-h-screen">
      <aside class="border-b lg:border-b-0 lg:border-r border-slate-800 p-4 lg:h-screen lg:sticky lg:top-0 lg:overflow-y-auto">
        <a href={withBase("/")} class="flex items-center gap-2 mb-4 px-2">
          <span class="text-lg font-bold bg-gradient-to-r from-cyan-400 to-emerald-400 bg-clip-text text-transparent">
            learncpp
          </span>
        </a>
        <div class="px-2 mb-4">
          <ProgressBar client:load allExerciseSlugs={exerciseSlugs} />
        </div>
        <Sidebar client:load modules={modules} currentLessonSlug={currentLessonSlug} />
        <div class="mt-6 px-2">
          <ProgressTools client:load />
        </div>
      </aside>
      <main class="p-4 sm:p-6 lg:p-8 max-w-6xl w-full mx-auto min-w-0">
        <slot />
      </main>
    </div>
  </body>
</html>
